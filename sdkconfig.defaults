# Settings espOS requires from a registry consumer (copied from its
# from_registry example; espos_core checks them at configure time).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# espos_time asks DHCP for an NTP server by default; without this SNTP
# fails to start. Room for two configured servers plus DHCP's.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# Signed images: a device only accepts OTA updates signed with the key it was
# flashed with. The key is not in git; see USER_MANUAL.md.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The board's chip: ESP32-S3R8, 8 MB octal PSRAM at 3.3 V inside the
# package (from the boot log's chip report, 2026-09-25), 16 MB flash.
# Allocations above 16 KB (CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL's default),
# like espOS's settings schema, go to PSRAM; small ones, and everything an
# interrupt touches, stay in internal RAM. If PSRAM ever fails to start,
# the firmware boots without it rather than stopping. Octal PSRAM uses
# GPIO 33-37, which nothing on this board is wired to.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Metadata slots: espOS uses up to 9 for its own device paths; the two
# switch-bank trees need up to 32 (8 relays + 8 inputs, twice).
CONFIG_ESPOS_SK_MAX_META=48

# Task watchdog, as espOS's own builds set it (sdkconfig.d/espos.defaults):
# a watched task silent for 30 s panics, core-dumps and restarts. 30 s, not
# IDF's 5 s, because espOS tasks may block on a slow HTTP round trip. The
# relay I/O loop has its own 3 s check in main.c.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y

# Sockets for everything at once: espOS's web server (up to 6, plus the
# browser's keep-alive connections), the SignalK stream and its metadata
# requests, mDNS, SNTP and OTA. IDF's default of 10 ran out when a browser
# was on the setup page as SignalK connected ("Failed to create socket"),
# and espOS's SignalK task then overflowed its stack on the error path.
CONFIG_LWIP_MAX_SOCKETS=16
