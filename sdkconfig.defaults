# Settings espOS requires from a registry consumer (copied from its
# from_registry example; espos_core checks them at configure time).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Signed images: a device only accepts OTA updates signed with the key it was
# flashed with. The key is not in git; see USER_MANUAL.md.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The board's module: 16 MB flash, 8 MB PSRAM. PSRAM stays off until its
# type (quad or octal) is confirmed on hardware; the wrong mode stops boot.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Metadata slots: espOS uses up to 9 for its own device paths; the two
# switch-bank trees need up to 32 (8 relays + 8 inputs, twice).
CONFIG_ESPOS_SK_MAX_META=48
